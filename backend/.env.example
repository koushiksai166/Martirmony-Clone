NODE_ENV=development

PORT=5001

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/matrimony?schema=public

JWT_SECRET=my_super_access_secret
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=my_super_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PREMIUM_PLAN_AMOUNT=49900
PAYMENT_CURRENCY=INR

# SMTP (Nodemailer) — leave blank to disable welcome emails
# Option A: Gmail app password (matches existing EMAIL_USER / EMAIL_PASS keys)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password

# Option B: Generic SMTP (overrides Gmail if SMTP_HOST is set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@saanjh.com

# Admin bootstrap (used only by scripts/bootstrap-admin.ts)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Upload — local disk only (development). Replace with Cloudinary/S3/R2 before deploying to Render.
# UPLOAD_MAX_SIZE_MB=5